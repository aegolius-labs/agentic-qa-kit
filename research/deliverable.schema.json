{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegolius-labs.example/schemas/qa-research-deliverable-2026.json",
  "title": "Isolated QA research deliverable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "subject_title",
    "theoretical_foundations",
    "practical_architecture_and_implementation",
    "primary_evidence",
    "failure_modes_and_antipatterns",
    "maturity_matrix"
  ],
  "properties": {
    "subject_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "subject_title": {"type": "string", "minLength": 8},
    "theoretical_foundations": {"type": "string", "minLength": 500},
    "practical_architecture_and_implementation": {"type": "string", "minLength": 500},
    "primary_evidence": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_title",
          "authors_or_institution",
          "year",
          "source_type",
          "doi_or_url",
          "verbatim_excerpt",
          "analytical_interpretation"
        ],
        "properties": {
          "source_title": {"type": "string", "minLength": 5},
          "authors_or_institution": {"type": "string", "minLength": 2},
          "year": {"type": "integer", "minimum": 1900, "maximum": 2026},
          "source_type": {
            "type": "string",
            "enum": ["ACM", "IEEE", "ISO", "University_Courseware", "Formal_Standard"]
          },
          "doi_or_url": {"type": "string", "pattern": "^https://"},
          "verbatim_excerpt": {"type": "string", "minLength": 3},
          "analytical_interpretation": {"type": "string", "minLength": 20}
        }
      }
    },
    "failure_modes_and_antipatterns": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 10}
    },
    "maturity_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundational", "advanced", "expert_2026"],
      "properties": {
        "foundational": {"type": "string", "minLength": 20},
        "advanced": {"type": "string", "minLength": 20},
        "expert_2026": {"type": "string", "minLength": 20}
      }
    }
  }
}
